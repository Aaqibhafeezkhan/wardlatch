{
  "name": "wardlatch",
  "version": "0.1.18",
  "description": "Security check for macOS and Linux: runtimes trusting revoked or leaked CA keys, vulnerable versions, swapped binaries. Local, no telemetry. npx wardlatch@latest",
  "type": "module",
  "bin": {
    "wardlatch": "bin/wardlatch.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/never-false-safe/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=bin/** --test-coverage-include=lib/** --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80 test/*.test.mjs"
  },
  "keywords": [
    "security",
    "security-scanner",
    "vulnerability-scanner",
    "scanner",
    "security-audit",
    "audit",
    "cli",
    "npx",
    "cve",
    "cisa-kev",
    "kev",
    "trust-store",
    "ca-certificates",
    "root-certificates",
    "certificate-authority",
    "revoked-certificates",
    "certificate",
    "tls",
    "ssl",
    "macos",
    "linux",
    "supply-chain",
    "supply-chain-security",
    "incident-response",
    "devsecops",
    "ci",
    "lockfile",
    "no-telemetry",
    "emudhra"
  ],
  "license": "Apache-2.0",
  "author": "Deimos AI LLC",
  "homepage": "https://www.deimoscore.com/wardlatch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deimos-hq/wardlatch.git"
  },
  "bugs": {
    "url": "https://github.com/deimos-hq/wardlatch/issues"
  }
}
